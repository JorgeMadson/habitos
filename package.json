{
  "name": "entre-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test src/*.test.js",
    "test:rules": "node --test tests/firestore.integration.mjs",
    "test:integration": "firebase emulators:exec --only auth,firestore --project demo-entre \"npm run test:rules && playwright test\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "firebase-tools": "^15.30.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "firebase": "^12.19.0"
  }
}
