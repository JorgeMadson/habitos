rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function impact(i) {
      return i is map && i.keys().hasOnly(['goal','value'])
        && i.goal in ['dieta','fit','chines','concurso','carreira','renda','esposa','saas','dinheiro','tcg','musica']
        && i.value in ['positive','negative','neutral'];
    }
    function validEntry(id) {
      let e = request.resource.data;
      let n = e.impacts.size();
      let goalIds = [e.impacts[0].goal,
        n > 1 ? e.impacts[1].goal : '1', n > 2 ? e.impacts[2].goal : '2',
        n > 3 ? e.impacts[3].goal : '3', n > 4 ? e.impacts[4].goal : '4',
        n > 5 ? e.impacts[5].goal : '5', n > 6 ? e.impacts[6].goal : '6',
        n > 7 ? e.impacts[7].goal : '7', n > 8 ? e.impacts[8].goal : '8',
        n > 9 ? e.impacts[9].goal : '9', n > 10 ? e.impacts[10].goal : '10'];
      return e.keys().hasOnly(['id','action','at','impacts','minutes','note','relation','previousId','deleted'])
        && e.id == id && id.matches('^[A-Za-z0-9_-]{1,128}$')
        && e.action is string && e.action.size() > 0 && e.action.size() <= 100
        && e.at is string && e.at.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$')
        && e.impacts is list && n > 0 && n <= 11 && goalIds.toSet().size() == 11
        && impact(e.impacts[0]) && (n < 2 || impact(e.impacts[1]))
        && (n < 3 || impact(e.impacts[2])) && (n < 4 || impact(e.impacts[3]))
        && (n < 5 || impact(e.impacts[4])) && (n < 6 || impact(e.impacts[5]))
        && (n < 7 || impact(e.impacts[6])) && (n < 8 || impact(e.impacts[7]))
        && (n < 9 || impact(e.impacts[8])) && (n < 10 || impact(e.impacts[9]))
        && (n < 11 || impact(e.impacts[10]))
        && e.minutes is number && e.minutes >= 0 && e.minutes <= 1440
        && e.note is string && e.note.size() <= 2000
        && e.relation in ['yes','no','unsure']
        && (e.previousId == null || (e.previousId is string && e.previousId.matches('^[A-Za-z0-9_-]{1,128}$')))
        && e.deleted is bool;
    }
    match /users/{uid}/entries/{id} {
      allow read: if owner(uid);
      allow create: if owner(uid) && validEntry(id) && request.resource.data.deleted == false;
      // Keep tombstones: an old backup or offline context edit must not resurrect deleted actions.
      allow update: if owner(uid) && validEntry(id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['minutes','note','relation','deleted'])
        && (resource.data.deleted == false || request.resource.data.deleted == true);
      allow delete: if false;
    }
  }
}
